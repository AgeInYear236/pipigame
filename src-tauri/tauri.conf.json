{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pipitest",
  "version": "0.1.0",
  "identifier": "com.ageinyear.pipi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "pipitest_game",
        "width": 1920,
        "height": 1000,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "active": true,
    "targets": "appimage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
